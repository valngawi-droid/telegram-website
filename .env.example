# ============ PALLBOT — Konfigurasi (bot-only) ============
# Salin: cp .env.example .env  lalu isi.
# JANGAN commit file .env berisi key asli ke git!

# ---------- BOT TELEGRAM ----------
# Token dari @BotFather
BOT_TOKEN=
# API ID & Hash dari https://my.telegram.org (WAJIB: buat channel/grup, join invite)
API_ID=
API_HASH=
# Username bot (tanpa @)
BOT_USERNAME=pallbot

# ---------- USERBOT (WAJIB untuk Buat Channel/Grup) ----------
# Telegram melarang BOT membuat channel — create memakai akun user (userbot).
# Login sekali: python deploy/userbot_login.py
# Nomor userbot, format 62812... (tanpa +, tanpa 0 di depan 8)
USER_PHONE=
# Password 2FA akun userbot (untuk transfer ownership ke owner pilihan)
USER_2FA=

# ---------- AI ----------
# Provider: gemini | openai (kompatibel OpenAI: OpenAI/Groq/OpenRouter/dll)
AI_PROVIDER=gemini
AI_PROJECT=216372639628
AI_MODEL=gemini-2.0-flash
# API key AI — ISI DI FILE .env (JANGAN di-commit!)
AI_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini

# ---------- IZIN & LIMIT CREATE ----------
# Default limit create per member yang di-whitelist (owner: unlimited)
CREATE_LIMIT=10
# Tujuan "Chat dengan Owner" (ID Telegram)
OWNER_CHAT_ID=8861238621

# ---------- BOT WHATSAPP (folder wa/) ----------
# Nomor WA tujuan "Chat dengan Owner" (tanpa +, tanpa spasi)
WA_OWNER_CHAT=
# Daftar owner WA (pilih owner saat buat grup + deteksi admin), dipisah |
# Contoh: WA_OWNERS=628861238621:Pall Utama|6288719750003:Pall 2|628897520559:Pacar
WA_OWNERS=
