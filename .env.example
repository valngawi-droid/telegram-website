# ============ PALLBOT — Konfigurasi ============
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env

# Token bot dari @BotFather (WAJIB untuk bot berjalan)
BOT_TOKEN=

# API ID & API Hash dari https://my.telegram.org (WAJIB untuk fitur Buat Channel/Grup)
API_ID=
API_HASH=

# Username bot (tanpa @). Auto-update dari getMe saat online.
BOT_USERNAME=pallbot

# Password panel admin (bisa diubah lagi di menu Pengaturan)
ADMIN_PASSWORD=pall123

# ---------- AI ----------
# Provider: "gemini" atau "openai"
AI_PROVIDER=gemini
# Untuk gemini: project number + model
AI_PROJECT=216372639628
AI_MODEL=gemini-2.0-flash
# API key AI (JANGAN commit key asli ke git — isi di file .env di VPS,
# atau lewat website Panel Admin -> Pengaturan -> "API KEY AI")
AI_KEY=
# Untuk openai-compatible: base url + model
AI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini

# Port website (default 8000)
WEB_PORT=8000
